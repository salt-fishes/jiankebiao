<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 同步课程到系统日历（只写专属「简课表」本地日历） -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <!-- 操作触感反馈（普通权限，无需运行时申请） -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- 开机后重排课前提醒 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 精确闹钟：USE_EXACT_ALARM 在 API 33+ 自动授予（课表提醒为应用核心功能）；
         API 31/32 由 SCHEDULE_EXACT_ALARM 覆盖（默认授予）；API 30- 本就允许精确闹钟。
         授予后走 setExactAndAllowWhileIdle 准点触发，不再依赖窗口闹钟降级。 -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 系统分享面板导入（ACTION_SEND）：微信/QQ 分享课表文件直达解析 -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="application/vnd.ms-excel" />
                <data android:mimeType="application/msexcel" />
                <data android:mimeType="application/x-xls" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" />
                <data android:mimeType="application/CDFV2" />
                <!-- 微信分享 .xls 常报 octet-stream，声明后按魔数校验 -->
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
            <!-- 文件管理器/聊天「用其他应用打开」（ACTION_VIEW） -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="application/vnd.ms-excel" />
                <data android:mimeType="application/msexcel" />
                <data android:mimeType="application/x-xls" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" />
                <data android:mimeType="application/CDFV2" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
        </activity>

        <!-- 前台解析服务：OCR 解析耗时较长，独立前台运行避免界面被回收 -->
        <service
            android:name=".ScheduleParseService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- 今日课程桌面小组件（2×4 列表） -->
        <receiver
            android:name=".widget.ScheduleWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/schedule_widget_info_2x4" />
        </receiver>

        <!-- 今日课程桌面小组件（2×3 列表） -->
        <receiver
            android:name=".widget.ScheduleWidgetMediumProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/schedule_widget_info_2x3" />
        </receiver>

        <!-- 今日课程桌面小组件（2×2 紧凑） -->
        <receiver
            android:name=".widget.ScheduleWidgetCompactProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/schedule_widget_info_2x2" />
        </receiver>

        <!-- 小组件列表数据源（仅系统绑定） -->
        <service
            android:name=".widget.ScheduleWidgetService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />

        <!-- 课表分享图：授权系统分享面板读取 cache/share 下的 PNG -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- 课前提醒：闹钟触发 + 开机重排 -->
        <receiver
            android:name=".reminder.ReminderReceiver"
            android:exported="false" />

        <receiver
            android:name=".reminder.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
